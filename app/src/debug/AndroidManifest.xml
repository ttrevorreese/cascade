<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only. DUMP is held by the adb shell, not by third-party apps. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.cascade.alarm.debug.RING_IN" />
                <action android:name="com.cascade.alarm.debug.SET_TIMEOUT" />
                <action android:name="com.cascade.alarm.debug.SET_DAILY" />
                <action android:name="com.cascade.alarm.debug.DISABLE" />
                <action android:name="com.cascade.alarm.debug.DISMISS" />
                <action android:name="com.cascade.alarm.debug.SET_WAKE_CHECK" />
                <action android:name="com.cascade.alarm.debug.SEED_DEMO" />
                <action android:name="com.cascade.alarm.debug.RING_POSITION" />
                <action android:name="com.cascade.alarm.debug.SET_CHALLENGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
